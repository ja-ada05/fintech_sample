# Copy to backend/.env or export these in your shell before running uvicorn.

# MySQL — the migrated `credit` schema (main platform)
DATABASE_URL=mysql://root@localhost:3306/credit

# Auth — change these in production
JWT_SECRET=change-me-in-prod
JWT_TTL=28800

# Default seeded admin (created on first boot if the users table is empty)
# username: admin / password: admin123
